# Roadside Japan — environment example. Copy to `.env` (gitignored) for local use.
# These are read by the AI agent toolchain (tools/agent/*) and the build.
# NEVER commit real API keys.

# --- AI providers (only the ones you use need values) -----------------------

# Ollama — local & free. Run `ollama serve`; no key needed. Auto-detected.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Preferred provider for the CLI/server when several are available (ollama|openai|anthropic|gemini)
# RJ_PROVIDER=ollama

# Local agent server port (backs the /admin chat UI)
# AGENT_PORT=8787

# --- Site build -------------------------------------------------------------

# Override only for custom domains / <user>.github.io repos (default targets a project site).
# SITE_URL=https://example.com
# SITE_BASE=/

# Optional no-login comment intake (Formspree, a Cloudflare Worker, etc.).
# Must be prefixed PUBLIC_ to be exposed to the browser. Leave empty to fall back to GitHub issues.
# PUBLIC_COMMENTS_ENDPOINT=

# Optional no-login PLACE intake — the submission Worker URL (see tools/submit-worker/).
# When set, /submit and /add publish a place straight to the map; empty = GitHub-issue fallback.
# PUBLIC_SUBMIT_ENDPOINT=
