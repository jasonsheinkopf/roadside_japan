    "fuse.js": "^7.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/leaflet": "^1.9.17",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^25.9.3",
    "sharp": "^0.34.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3"
  }
