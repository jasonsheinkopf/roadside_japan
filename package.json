  "description": "Roadside Japan — discover the Japan most tourists never see. A community + AI-curated atlas of hidden gems, weird attractions, seasonal events, and roadside discoveries.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
