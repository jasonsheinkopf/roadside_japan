---
/**
 * ViewTabs — List | Map | When-to-go as three VIEWS of the same filtered atlas.
 *
 * Explore, Map, and Timeline are one page with three presentations. Each renders this
 * full-width segmented control in the SAME position (under the "Explore" title), so
 * switching views never shifts the layout. A tiny inline script copies the current query
 * string onto the other tabs' hrefs, so filters/search/dates survive the switch (each
 * page ignores params it doesn't use).
 */
import { exploreUrl, mapUrl, timelineUrl } from "../lib/url";

interface Props {
  active: "list" | "map" | "timeline";
}
const { active } = Astro.props;

const tabs = [
  { id: "list", label: "List", icon: "📋", href: exploreUrl() },
  { id: "map", label: "Map", icon: "🗺️", href: mapUrl() },
  { id: "timeline", label: "When to go", icon: "🗓️", href: timelineUrl() },
] as const;
---

<nav class="grid grid-cols-3 gap-1 rounded-full border border-line bg-surface-2 p-1" aria-label="View">
  {
    tabs.map((t) => (
      <a
        href={t.href}
        data-viewtab
        class:list={[
          "flex items-center justify-center gap-1.5 rounded-full px-2 py-1.5 text-sm font-medium transition",
          active === t.id ? "bg-surface text-sun shadow-sm" : "text-ink-soft hover:text-ink",
        ]}
        aria-current={active === t.id ? "page" : undefined}
      >
        <span aria-hidden="true">{t.icon}</span>
        <span>{t.label}</span>
      </a>
    ))
  }
</nav>

<script is:inline>
  // Carry the current filters/search/dates across views.
  document.querySelectorAll("[data-viewtab]").forEach((a) => {
    if (location.search) a.setAttribute("href", a.getAttribute("href").split("?")[0] + location.search);
  });
</script>
