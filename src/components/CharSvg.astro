---
/**
 * CharSvg — one Cinnamon-Land character as inline SVG (no external requests).
 * The canonical look is documented in docs/CINNAMON.md §1.5; both the scene and the
 * comic draw the cast from here so they never drift apart.
 */
interface Props {
  who: "cinnamon" | "socks" | "mon";
  /** Face left (default) or flip to face right. */
  flip?: boolean;
  /** Tailwind size classes, e.g. "h-20 w-20". */
  size?: string;
  /** Unique suffix so Cinnamon's gradient ids don't collide across instances. */
  uid?: string;
}
const { who, flip = false, size = "h-20 w-20", uid = Math.random().toString(36).slice(2, 8) } = Astro.props;
const transform = flip ? "scaleX(-1)" : "";
---

{
  who === "cinnamon" && (
    <svg viewBox="0 0 240 240" class:list={["shrink-0 drop-shadow-md", size]} style={`transform:${transform};`} aria-hidden="true">
      <defs>
        <linearGradient id={`sq-${uid}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9c7c55" /><stop offset="1" stop-color="#7d6242" /></linearGradient>
        <linearGradient id={`tl-${uid}`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8a6c49" /><stop offset="1" stop-color="#6b5236" /></linearGradient>
      </defs>
      <ellipse cx="118" cy="222" rx="56" ry="11" fill="#000" opacity="0.10" />
      <path d="M150 205 q70 -10 60 -90 q-8 -56 -54 -52 q34 6 38 50 q6 56 -52 70z" fill={`url(#tl-${uid})`} stroke="#5e4a32" stroke-width="2" />
      <path d="M168 70 q26 8 24 48 q-2 26 -18 40" fill="none" stroke="#a98a63" stroke-width="6" stroke-linecap="round" opacity="0.7" />
      <path d="M82 205 q-12 -78 42 -82 q54 4 42 82 z" fill={`url(#sq-${uid})`} />
      <path d="M104 205 q-12 -60 20 -64 q32 4 20 64 z" fill="#e9d8bd" />
      <ellipse cx="98" cy="206" rx="16" ry="9" fill="#caa97e" />
      <ellipse cx="146" cy="206" rx="16" ry="9" fill="#caa97e" />
      <ellipse cx="122" cy="86" rx="42" ry="40" fill={`url(#sq-${uid})`} />
      <path d="M92 56 q-6 -28 12 -24 q8 4 6 22z" fill="#7d6242" />
      <path d="M152 56 q6 -28 -12 -24 q-8 4 -6 22z" fill="#7d6242" />
      <path d="M94 46 q-4 -14 6 -16M150 46 q4 -14 -6 -16" stroke="#5e4a32" stroke-width="3" fill="none" stroke-linecap="round" />
      <ellipse cx="100" cy="98" rx="8" ry="6" fill="#e7b0a2" opacity="0.55" />
      <ellipse cx="144" cy="98" rx="8" ry="6" fill="#e7b0a2" opacity="0.55" />
      <ellipse cx="108" cy="84" rx="6" ry="7.5" fill="#241c16" />
      <ellipse cx="136" cy="84" rx="6" ry="7.5" fill="#241c16" />
      <circle cx="110" cy="81" r="2" fill="#fff" /><circle cx="138" cy="81" r="2" fill="#fff" />
      <path d="M117 96 h10 l-5 6z" fill="#2e2219" />
      <path d="M122 102 q-7 7 -14 3M122 102 q7 7 14 3" stroke="#3a2c24" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <path d="M96 118 q26 14 52 0 l-4 12 q-22 10 -44 0 z" fill="#7a8f52" stroke="#5f7040" stroke-width="2" />
      <path d="M118 128 l8 -2 l2 12 l-9 4 z" fill="#7a8f52" stroke="#5f7040" stroke-width="2" />
      <ellipse cx="108" cy="152" rx="9" ry="7" fill="#b9966c" />
      <ellipse cx="140" cy="148" rx="9" ry="7" fill="#b9966c" />
    </svg>
  )
}
{
  who === "socks" && (
    <svg viewBox="0 0 200 200" class:list={["shrink-0 drop-shadow-md", size]} style={`transform:${transform};`} aria-hidden="true">
      <ellipse cx="100" cy="186" rx="44" ry="8" fill="#000" opacity="0.10" />
      <path d="M148 172 q30 -4 26 -40 q-3 -22 -20 -26 q10 12 10 30 q0 26 -20 30z" fill="#26221f" stroke="#171412" stroke-width="2" />
