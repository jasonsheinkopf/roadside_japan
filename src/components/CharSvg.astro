      <path d="M72 112 q28 16 56 0 l-5 13 q-23 11 -46 0 z" fill="#6f8a4d" stroke="#57703a" stroke-width="2" />
      <circle cx="88" cy="119" r="2.2" fill="#f7ecd8" opacity="0.8" /><circle cx="102" cy="122" r="2.2" fill="#f7ecd8" opacity="0.8" /><circle cx="116" cy="118" r="2.2" fill="#f7ecd8" opacity="0.8" />
      <path d="M98 124 l8 -2 l2 11 l-9 4 z" fill="#6f8a4d" stroke="#57703a" stroke-width="2" />
    </svg>
  )
}
