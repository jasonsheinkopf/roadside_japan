---
/**
 * SceneArt — renders one bespoke, hand-composed place illustration (docs/SCENE_ART.md).
 *
 * Takes the raw authored SVG (viewBox 0 0 480 300) and drops it into a framed figure that
 * scales to its container. The SVG references the shared cast symbols via <use>, so any page
 * that renders SceneArt must include <AdventureCastDefs/> once (DetailLayout already does).
 *
 * Used both for the A/B comparison block and — once a winning model is chosen — as the real
 * hero/postcard art in place of the parametric CinnamonScene template.
 */
import { SCENE_MODEL_LABEL, type SceneModel } from "../lib/scenes";

interface Props {
  /** Raw authored SVG source (import ?raw). */
  raw: string;
  /** Accessible label for the illustration. */
  title: string;
  /** When set, shows a model chip (Sonnet / Opus) for the A/B comparison. */
  model?: SceneModel;
}
const { raw, title, model } = Astro.props;
---

<figure class="overflow-hidden rounded-2xl border border-line bg-surface">
  <div
    class="scene-art relative w-full"
    role="img"
    aria-label={title}
    set:html={raw}
  />
  {
    model && (
      <figcaption class="flex items-center gap-2 border-t border-line px-3 py-2 text-xs">
        <span class="chip border-transparent bg-sun/15 font-semibold text-sun">
          {SCENE_MODEL_LABEL[model]}
        </span>
        <span class="text-ink-soft">{title}</span>
      </figcaption>
    )
  }
</figure>

<style>
  /* The authored SVG carries its own 8:5 viewBox; make it fill the frame responsively. */
  .scene-art :global(> svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
