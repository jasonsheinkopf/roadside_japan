---
/**
 * CinnamonComic — "Adventures in Cinnamon Land", a short comic strip per entry.
 *
 * A 4–6 panel gag (docs/CINNAMON.md §7) whose punchline sneaks in the real tips for the
 * place. Each panel is a little vector scene — the cast (Cinnamon / Socks / Mon-chan) with
 * the panel's prop emoji on a soft seeded background — and the line runs as a caption BELOW
 * the art, comic-strip style (never a speech bubble, which we can't place reliably).
 */
import CharSvg from "./CharSvg.astro";
import { placeholderStyle } from "../lib/format";

interface Panel {
  cast: ("cinnamon" | "socks" | "mon")[];
  prop: string;
  caption: string;
}
interface Props {
  panels: Panel[];
  /** Entry slug — seeds the per-panel background hues deterministically. */
  seed: string;
}
const { panels, seed } = Astro.props;
---

<section class="mt-8">
  <h2 class="font-display text-xl font-bold">🎬 Adventures in Cinnamon Land</h2>
  <p class="mt-1 text-sm text-ink-soft">A tiny comic from the trip — the tips are hidden in the jokes.</p>

  <div class="mt-3 grid grid-cols-2 gap-3 sm:gap-4">
    {
      panels.map((panel, i) => (
        <figure class="overflow-hidden rounded-2xl border border-line bg-surface">
          <div
            class="bg-topo relative flex min-h-[128px] items-end justify-center gap-1 px-3 pt-4 sm:min-h-[168px]"
            style={placeholderStyle(`${seed}-${i}`)}
          >
            <span class="absolute left-2 top-2 rounded-full bg-surface/85 px-1.5 text-xs font-semibold text-ink-soft">{i + 1}</span>
            <span
              class="select-none self-center drop-shadow-lg"
              style={`font-size:${panel.cast.length > 1 ? 40 : 52}px; line-height:1;`}
              aria-hidden="true"
            >
              {panel.prop}
            </span>
            {panel.cast.map((who, j) => (
              <CharSvg
                who={who}
                flip={j % 2 === 1}
                size="h-16 w-16 sm:h-20 sm:w-20"
                uid={`${seed}-${i}-${j}`}
              />
            ))}
          </div>
          <figcaption class="border-t border-line px-3 py-2 text-xs leading-snug text-ink sm:text-sm">
            {panel.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <p class="mt-2 text-right text-[0.7rem] font-semibold uppercase tracking-wide text-ink-soft">
    Adventures in Cinnamon Land · 🐿️ 🐈‍⬛ 🐕
  </p>
</section>
