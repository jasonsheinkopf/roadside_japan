---
/**
 * Comments — lightweight, no-login, moderatable.
 *
 * Reading: approved comments are version-controlled files (collection "comments"), so
 * removing one is a commit and moderation is a boolean. They render here.
 *
 * Writing (progressive): the form works WITHOUT any backend by opening a prefilled GitHub
 * issue (the review queue). If the site owner sets PUBLIC_COMMENTS_ENDPOINT (e.g. a
 * Formspree URL or a Cloudflare Worker), the same form POSTs there instead — enabling true
 * no-login, in-page submission. A honeypot field deters basic spam bots. See docs/MODERATION.md.
 */
import { render } from "astro:content";
import type { CommentEntry } from "../lib/content";
import { newIssueUrl } from "../data/site";

interface Props {
  comments: CommentEntry[];
  target: string;
  targetType: "attraction" | "event";
  title: string;
}
const { comments, target, targetType, title } = Astro.props;

const rendered = await Promise.all(
  comments.map(async (c) => ({ data: c.data, Content: (await render(c)).Content })),
);

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });
const endpoint = import.meta.env.PUBLIC_COMMENTS_ENDPOINT ?? "";
const issueUrl = newIssueUrl({ template: "comment.yml", title: `Comment: ${title}`, labels: "comment" });
---

<section class="mt-12" aria-labelledby="comments-heading" id="comments">
  <h2 id="comments-heading" class="font-display text-2xl font-bold">
    Comments {rendered.length > 0 && <span class="text-ink-soft">({rendered.length})</span>}
  </h2>

  <ul class="mt-5 space-y-4">
    {
      rendered.map(({ data, Content }) => (
        <li class="card p-4">
          <div class="mb-1 flex items-center justify-between gap-3">
            <span class="font-semibold">{data.author}</span>
            <time class="text-xs text-ink-soft" datetime={data.createdAt.toISOString()}>
              {dateFmt.format(data.createdAt)}
            </time>
          </div>
          <div class="prose prose-sm max-w-none">
            <Content />
          </div>
        </li>
      ))
    }
    {rendered.length === 0 && <li class="text-ink-soft">No comments yet — be the first to share a tip.</li>}
  </ul>

  <form
    id="comment-form"
    class="card mt-6 p-4"
    data-endpoint={endpoint}
    data-issue-url={issueUrl}
    data-target={target}
    data-target-type={targetType}
  >
    <h3 class="font-display text-lg font-semibold">Leave a comment</h3>
    <p class="mb-3 text-sm text-ink-soft">
      Share a tip, a correction, or what you saw. Comments are reviewed before they appear —
      no account needed.
    </p>
    <!-- Honeypot: real users never see/fill this. -->
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class="grid gap-3 sm:grid-cols-2">
      <input
        name="author"
        type="text"
        placeholder="Name (optional)"
        class="rounded-lg border border-line bg-surface px-3 py-2 text-sm outline-none focus:border-sun"
      />
    </div>
    <textarea
      name="comment"
      required
      rows="3"
      placeholder="Your comment…"
      class="mt-3 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm outline-none focus:border-sun"
    ></textarea>
    <div class="mt-3 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">💬 Post comment</button>
      <span id="comment-status" class="text-sm text-ink-soft" role="status"></span>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById("comment-form") as HTMLFormElement | null;
  const status = document.getElementById("comment-status");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if ((fd.get("website") as string)?.length) return; // honeypot tripped → silently drop
    const comment = (fd.get("comment") as string)?.trim();
    if (!comment) return;
    const author = ((fd.get("author") as string) || "Anonymous traveler").trim();
    const endpoint = form.dataset.endpoint;

    if (endpoint) {
      try {
        if (status) status.textContent = "Sending…";
        await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            target: form.dataset.target,
            targetType: form.dataset.targetType,
            author,
            comment,
          }),
        });
        form.reset();
        if (status) status.textContent = "Thanks! Your comment is awaiting review.";
      } catch {
        if (status) status.textContent = "Couldn't send — please try the GitHub option.";
      }
      return;
    }

    // Zero-infra fallback: open a prefilled GitHub issue (the review queue).
    const url = new URL(form.dataset.issueUrl!);
    url.searchParams.set("body", `**From:** ${author}\n\n${comment}`);
    window.open(url.toString(), "_blank", "noopener");
    if (status) status.textContent = "Opening GitHub to post your comment…";
  });
</script>
