---
/**
 * AttractionCard — the workhorse grid card for attractions and events.
 * Takes a flattened IndexRecord so it works identically with server-rendered lists and
 * (via the same shape) client-rendered filter results.
 */
import type { IndexRecord } from "../lib/types";
import { CATEGORY_META } from "../data/categories";
import { SEASON_LABEL } from "../data/vocab";
import {
  COST_LABEL,
  TIME_LABEL,
  SEASON_EMOJI,
  formatDateRange,
  formatKm,
  placeholderStyle,
  IMG_ONERROR,
} from "../lib/format";

interface Props {
  record: IndexRecord;
  distanceKm?: number;
}
const { record: r, distanceKm } = Astro.props;
const cat = CATEGORY_META[r.category];
const isEvent = r.collection === "events";
const dateLabel =
  isEvent && r.startDate && r.endDate
    ? formatDateRange(new Date(r.startDate), new Date(r.endDate))
    : null;
const costLabel = r.costType === "free" ? "Free" : COST_LABEL[r.costType];
---

<a
  href={r.url}
  class="card group flex flex-col overflow-hidden transition duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5"
>
  <div class="relative aspect-[16/10] overflow-hidden">
    {
      r.hero ? (
        <img
          src={r.hero}
          alt={r.title}
          loading="lazy"
          decoding="async"
          onerror={IMG_ONERROR}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="bg-topo flex h-full w-full items-center justify-center" style={placeholderStyle(r.id)}>
          <span class="text-5xl drop-shadow-sm" aria-hidden="true">
            {cat.emoji}
          </span>
        </div>
      )
    }
    <div class="absolute left-2 top-2 flex flex-wrap gap-1">
      <span class="chip border-transparent bg-canvas/85 text-xs backdrop-blur">{cat.emoji} {cat.label}</span>
      {isEvent && <span class="chip border-transparent bg-sun text-xs text-white">Seasonal event</span>}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-lg font-semibold leading-snug transition group-hover:text-sun" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
      {r.title}
    </h3>
    <p class="mt-1.5 text-sm text-ink-soft" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
      {r.summary}
    </p>

    <div class="mt-auto pt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-soft">
      <span>📍 {r.prefectureName}{r.city ? `, ${r.city}` : ""}</span>
      <span>{r.costType === "free" ? "🆓" : r.costType === "paid" ? "💴" : "🎫"} {costLabel}</span>
      <span>⏱ {TIME_LABEL[r.timeRequired]}</span>
      {dateLabel && <span class="font-medium text-sun">🗓 {dateLabel}</span>}
      {typeof distanceKm === "number" && <span>· {formatKm(distanceKm)} away</span>}
    </div>

    {
      r.seasons.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1">
          {r.seasons.map((s) => (
            <span class="rounded-full bg-surface-2 px-2 py-0.5 text-[11px]">
              {SEASON_EMOJI[s]} {SEASON_LABEL[s]}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
