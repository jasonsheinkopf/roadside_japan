---
import { withBase, exploreUrl, mapUrl, homeUrl } from "../lib/url";
import { REGIONS } from "../data/prefectures";

const REPO = "https://github.com/jasonsheinkopf/roadside_japan";
const year = new Date().getFullYear();

const cols = [
  {
    title: "Explore",
    links: [
      { label: "All discoveries", href: exploreUrl() },
      { label: "Map", href: mapUrl() },
      { label: "Seasonal events", href: withBase("/events") },
      { label: "Random discovery", href: withBase("/random") },
      { label: "Prefectures", href: withBase("/prefectures") },
    ],
  },
  {
    title: "Seasons",
    links: [
      { label: "Spring 🌸", href: withBase("/seasons/spring") },
      { label: "Summer 🌻", href: withBase("/seasons/summer") },
      { label: "Autumn 🍁", href: withBase("/seasons/autumn") },
      { label: "Winter ❄️", href: withBase("/seasons/winter") },
    ],
  },
  {
    title: "Contribute",
    links: [
      { label: "Submit a place", href: withBase("/submit") },
      { label: "About the project", href: withBase("/about") },
      { label: "Admin & AI tools", href: withBase("/admin") },
      { label: "Source on GitHub", href: REPO },
    ],
  },
];
---

<footer class="mt-20 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href={homeUrl()} class="flex items-center gap-2">
        <img src={withBase("/icon.svg")} width="32" height="32" class="h-8 w-8" alt="" />
        <span class="font-display text-lg font-bold">Roadside <span class="text-sun">Japan</span></span>
      </a>
      <p class="mt-3 max-w-xs text-sm text-ink-soft">
        An open, community- and AI-curated atlas of the strange, the seasonal, and the
        overlooked — the Japan most tourists never see.
      </p>
      <p class="mt-3 flex items-center gap-2 text-sm text-ink-soft">
        <img src={withBase("/images/mon-chan.svg")} width="32" height="32" class="h-8 w-8" alt="" />
        <span>Hosted by <strong class="text-ink">Mon-chan</strong>, our globe-trotting Shiba. ✌️</span>
      </p>
      <p class="mt-3 text-xs text-ink-soft">
        Map data © OpenStreetMap contributors. Content under CC BY-SA 4.0 · Code MIT.
      </p>
    </div>

    {
      cols.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-sm font-semibold tracking-wide text-ink-soft uppercase">{col.title}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-sun">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-ink-soft sm:flex-row sm:px-6">
      <p>© {year} Roadside Japan · A passion project, not a tour company.</p>
      <p class="flex items-center gap-3">
        <a href={withBase("/rss.xml")} class="hover:text-sun">RSS</a>
        <span aria-hidden="true">·</span>
        <span>{REGIONS.length} regions · 47 prefectures</span>
      </p>
    </div>
  </div>
</footer>
