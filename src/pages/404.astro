---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeUrl, exploreUrl, mapUrl, withBase } from "../lib/url";
---

<BaseLayout title="Lost" noindex>
  <div class="flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <img
      src={withBase("/images/team/cinnamon.webp")}
      width="160"
      height="160"
      class="h-40 w-40 rounded-2xl border border-line object-cover"
      alt="Cinnamon the squirrel with his travel suitcase, looking ready to help you find your way"
    />
    <h1 class="mt-4 font-display text-4xl font-bold">You've wandered off the map.</h1>
    <p class="mt-2 max-w-md text-ink-soft">
      That's usually how the best discoveries happen — but this particular road leads nowhere.
      Cinnamon has been lost in eleven prefectures and highly recommends it, but only on purpose.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={homeUrl()} class="btn btn-primary">Back home</a>
      <a href={exploreUrl()} class="btn btn-ghost">Explore</a>
      <a href={mapUrl()} class="btn btn-ghost">Open the map</a>
      <a href={withBase("/random")} class="btn btn-ghost">🎲 Surprise me</a>
    </div>
  </div>
</BaseLayout>
