---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";

/**
 * The drop box — ONE free-text field, no account, no structure.
 *
 * Visitors write anything: a single tip, ten places in one paragraph, a trip route with
 * dates, a request for a country we don't cover yet. An AI agent (Cinnamon's brain)
 * triages the queue on demand — parsing, verifying, and publishing what clears the bar —
 * per docs/INBOX.md. So the form's job is only to capture raw text with zero friction.
 *
 * The POST goes to a tiny Cloudflare Worker (tools/submit-worker/) that files it as a
 * GitHub issue labeled `inbox` in the private content repo. The endpoint URL is baked in
 * at build time from the PUBLIC_SUBMIT_ENDPOINT repo variable; until it's configured we
 * show a friendly "warming up" card instead of a dead form.
 */
const endpoint = import.meta.env.PUBLIC_SUBMIT_ENDPOINT ?? "";
---

<BaseLayout
  title="Submit a discovery"
  description="Tell Cinnamon about a place — one text box, no account, no forms. He'll research it and add the good ones."
>
  <div class="mx-auto max-w-2xl py-8">
    <header class="mb-6">
      <h1 class="font-display text-3xl font-bold sm:text-4xl">Tell Cinnamon 🐿️</h1>
      <p class="mt-3 text-ink-soft">
        Know a place that belongs in the atlas? Just write it below — no account, no forms.
        Cinnamon (a very busy squirrel, assisted by AI) reads every note, researches the
        places himself, and adds the ones that make the cut.
      </p>
    </header>

    <div class="card mb-6 p-5 text-sm text-ink-soft">
      <p class="font-medium text-ink">You can write anything, in any language, any format:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <li>One place — or ten places in a single paragraph.</li>
        <li>A tip: <em>"there's a restaurant near Ueno with udon made from silkworms"</em>.</li>
        <li>Your trip: route, cities, and dates — and what kind of places you're hoping to find along it.</li>
        <li>A country we don't cover yet. Cinnamon travels.</li>
        <li><strong>Optional:</strong> your name or handle → you'll be credited on every place we add.</li>
        <li><strong>Optional:</strong> your email → Cinnamon writes you back once he's been. (His friend Socks the cat types the reply — Cinnamon has no thumbs. Socks does not fix his own spelling. You'll see.)</li>
      </ul>
    </div>

    <div class="mb-6 flex items-center gap-4 rounded-2xl border border-line bg-surface p-4">
      <img
        src={withBase("/images/team/socks.webp")}
        alt="Socks the tuxedo cat at his MEOWriter typewriter, buried in letters"
        class="h-20 w-20 shrink-0 rounded-xl border border-line object-cover"
        loading="lazy"
      />
      <p class="text-sm italic text-ink-soft">
        "hi im socks, i handle teh mail. every note gets red. if u leave ur email i will
        personaly type u back (one paw). ur name gets speled RIGHT, i promise that part."
      </p>
    </div>

    {
      endpoint ? (
        <form id="dropbox-form" class="card p-5">
          <label class="mb-2 block text-sm font-medium" for="f-text">Your note to Cinnamon</label>
          <textarea
            id="f-text"
            name="text"
            required
            rows="10"
            maxlength="20000"
            class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun"
            placeholder={
              "e.g. Three tips from my Kansai trip: the giant whale shrine gate in Taiji, a vending-machine corner in Osaka that sells fresh eggs, and a tiny museum of fake food in Gujo Hachiman (that one might be Gifu?).\n\nI'm Maya — maya@example.com if you want to tell me when they're up!"
            }
          />
          <!-- Honeypot: hidden from humans; bots that fill it are silently dropped. -->
          <input type="text" name="hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="mt-3 flex items-center gap-3">
            <button type="submit" class="btn btn-primary">📮 Send it to Cinnamon</button>
            <span id="dropbox-status" class="text-sm text-ink-soft" role="status" />
          </div>
        </form>
      ) : (
        <div class="card border-sun/40 bg-sun/5 p-5">
          <h2 class="font-display text-lg font-semibold">The drop box is being built 🛠️</h2>
          <p class="mt-1 text-sm text-ink-soft">
            Submissions open soon. In the meantime, Cinnamon is out there discovering places
            on his own — check the <a href={withBase("/new")} class="link-underline text-sun">newest finds</a>.
          </p>
        </div>
      )
    }

    <div id="dropbox-thanks" class="card hidden border-sun/40 bg-sun/5 p-6 text-center">
      <p class="text-4xl" aria-hidden="true">🐿️📮</p>
      <h2 class="mt-2 font-display text-xl font-semibold">Got it — thanks!</h2>
      <p class="mt-2 text-sm text-ink-soft">
        Your note is in Cinnamon's inbox. He's a very busy squirrel, so give him a little
        time; if you left an email, he'll let you know when it's been processed. New
        additions show up on the <a href={withBase("/new")} class="link-underline text-sun">New</a> page.
      </p>
      <button id="dropbox-again" type="button" class="btn btn-ghost mt-4">Send another</button>
    </div>

    <p class="mt-6 text-xs text-ink-soft">
      Everything is reviewed before publishing — Cinnamon verifies each place independently
      and only adds what's real, safe, and at least a little bit wonderful.
    </p>
  </div>

  <script type="application/json" id="cl-endpoint" set:html={JSON.stringify(endpoint)} is:inline />
</BaseLayout>

<script>
  const endpoint = JSON.parse(document.getElementById("cl-endpoint")!.textContent || '""');
  const form = document.getElementById("dropbox-form") as HTMLFormElement | null;
  const status = document.getElementById("dropbox-status");
  const thanks = document.getElementById("dropbox-thanks");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const text = ((fd.get("text") as string) || "").trim();
    if (!text) return;

    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    if (status) status.textContent = "Sending…";

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text, hp: (fd.get("hp") as string) || "" }),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error || "failed");
      form.classList.add("hidden");
      thanks?.classList.remove("hidden");
    } catch {
      if (status) status.textContent = "Hmm, that didn't go through — please try again in a minute.";
      btn.disabled = false;
    }
  });

  document.getElementById("dropbox-again")?.addEventListener("click", () => {
    thanks?.classList.add("hidden");
    form?.classList.remove("hidden");
    form?.reset();
    const btn = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;
    if (btn) btn.disabled = false;
    if (status) status.textContent = "";
  });
</script>
