---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../data/vocab";
import { CATEGORY_META } from "../data/categories";
import { PREFECTURES } from "../data/prefectures";
import { SEASONS, SEASON_LABEL } from "../data/vocab";
import { SITE } from "../data/site";
import { withBase } from "../lib/url";

/**
 * "Add it with ChatGPT" — the easiest path from a phone, no account on our side and no API
 * keys. We deep-link to ChatGPT (works with any free or paid account) prefilled with a prompt
 * that turns it into a submission assistant: it interviews the visitor, then hands back a
 * one-tap link to our own /add page (NOT a hand-built GitHub URL — that was fragile). The /add
 * page assembles the real request and publishes via the submission Worker. Vocab lists are
 * injected so ChatGPT only ever picks a valid category/prefecture.
 */
const prefectureSlugs = PREFECTURES.map((p) => p.slug).join(", ");
const addUrl = new URL(withBase("/add"), Astro.site ?? "https://jasonsheinkopf.github.io").href;

const chatGptPrompt = `You are the Roadside Japan submission assistant. Roadside Japan (${SITE.repo}) is a community atlas of Japan's hidden gems, weird roadside attractions, and seasonal events.

Help me submit one new place. Ask me a couple of short questions at a time until you have:
1. The name of the place.
2. Where it is — prefecture and city. I may give a Google Maps link or address; if not, look up the coordinates from the name (you MUST end up with a decimal latitude and longitude inside Japan).
3. A one-line summary, and 2–4 sentences on why it's worth visiting (what's strange, special, or overlooked).
4. Best time to go (seasons) if it's seasonal; otherwise it's year-round.
5. Optional: a website and the name/handle to credit me as.

Rules: don't invent facts about the place — only use what I tell you (you MAY look up its prefecture and coordinates). Keep it tight and friendly.

When you have everything, give me ONE tap-to-open link that adds it to the map. Build it from this base URL, appending the fields as URL-encoded query parameters (encode each value):

${addUrl}?title=NAME&summary=ONE_LINE&description=WHY&category=CATEGORY&prefecture=PREF_SLUG&city=CITY&lat=LATITUDE&lng=LONGITUDE&seasons=SEASONS&website=URL&by=CREDIT

where:
- category is exactly one of: ${CATEGORIES.join(", ")}
- prefecture is exactly one of these lowercase slugs: ${prefectureSlugs}
- lat and lng are decimal numbers (required — always include them)
- seasons is a comma-separated subset of: spring, summer, autumn, winter (omit if year-round)
- omit any optional field you don't have

Then tell me: tap the link, glance over the details on the page that opens, and tap "Add to the map" — it'll be live in a minute or two.

Start by asking me what the place is.`;

const chatGptUrl = `https://chatgpt.com/?q=${encodeURIComponent(chatGptPrompt)}`;
---

<BaseLayout
  title="Submit a discovery"
  description="Add a hidden gem, weird attraction, or seasonal event to Roadside Japan. No account needed."
>
  <div class="py-8">
    <header class="mb-6 max-w-2xl">
      <h1 class="font-display text-3xl font-bold sm:text-4xl">Submit a discovery</h1>
      <p class="mt-2 text-ink-soft">
        Know a place that belongs in Roadside Japan? Tell us about it — <strong>no account
        needed</strong>. The easiest way is to let ChatGPT do it for you; or fill the form and
        it'll add your place to the map directly.
      </p>
    </header>

    <!-- Easiest path: hand it to ChatGPT -->
    <a
      href={chatGptUrl}
      target="_blank"
      rel="noopener"
      class="card mb-8 flex items-start gap-4 border-sun/40 bg-sun/5 p-5 transition hover:border-sun hover:bg-sun/10"
    >
      <span class="text-3xl" aria-hidden="true">🤖</span>
      <div class="min-w-0">
        <h2 class="font-display text-lg font-semibold">
          On your phone? Add it with ChatGPT <span class="text-sun">→</span>
        </h2>
        <p class="mt-1 text-sm text-ink-soft">
          Tap here to open ChatGPT (your own account, free or paid) already briefed as a
          Roadside Japan assistant. Just chat about the place — tell it the name and a rough
          location — and it hands you back a one-tap link that adds it straight to the map.
          No forms, no typing on a tiny keyboard.
        </p>
      </div>
    </a>

    <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
      <form id="submit-form" class="card space-y-4 p-5">
        <div>
          <label class="mb-1 block text-sm font-medium" for="f-title">Name of the place *</label>
          <input id="f-title" name="title" required class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" placeholder="e.g. The Moai of Kyushu" />
        </div>

        <div>
          <label class="mb-1 block text-sm font-medium" for="f-desc">Why is it worth visiting? *</label>
          <textarea id="f-desc" name="description" required rows="4" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" placeholder="What makes it strange, special, or overlooked?"></textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="mb-1 block text-sm font-medium" for="f-cat">Category</label>
            <select id="f-cat" name="category" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun">
              {CATEGORIES.map((c) => <option value={c}>{CATEGORY_META[c].emoji} {CATEGORY_META[c].label}</option>)}
            </select>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium" for="f-pref">Prefecture</label>
            <select id="f-pref" name="prefecture" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun">
              {PREFECTURES.map((p) => <option value={p.slug}>{p.name}</option>)}
            </select>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="mb-1 block text-sm font-medium" for="f-city">City / town</label>
            <input id="f-city" name="city" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium" for="f-loc">Location (address or map link)</label>
            <input id="f-loc" name="location" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" placeholder="Google Maps link or lat,lng" />
          </div>
        </div>

        <fieldset>
          <legend class="mb-1 text-sm font-medium">Best seasons (optional)</legend>
          <div class="flex flex-wrap gap-3">
            {SEASONS.map((s) => (
              <label class="flex items-center gap-1.5 text-sm">
                <input type="checkbox" name="seasons" value={s} /> {SEASON_LABEL[s]}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="mb-1 block text-sm font-medium" for="f-web">Website / link</label>
            <input id="f-web" name="website" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" placeholder="https://" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium" for="f-photos">Photo links / notes</label>
            <input id="f-photos" name="photos" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" placeholder="Links to photos, or any extra notes" />
          </div>
        </div>

        <div>
          <label class="mb-1 block text-sm font-medium" for="f-by">Your name / handle (optional)</label>
          <input id="f-by" name="submittedBy" class="w-full rounded-lg border border-line bg-surface px-3 py-2 outline-none focus:border-sun" placeholder="So we can credit you" />
        </div>

        <!-- Honeypot -->
        <input type="text" name="hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="flex items-center gap-3 pt-1">
          <button type="submit" class="btn btn-primary">➕ Continue</button>
          <span id="submit-status" class="text-sm text-ink-soft" role="status"></span>
        </div>
      </form>

      <aside class="space-y-4">
        <div class="card p-5">
          <h2 class="font-display text-lg font-semibold">How it works</h2>
          <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-sm text-ink-soft">
            <li>You describe the place (here, or via ChatGPT).</li>
            <li>You confirm the spot on a one-tap page.</li>
            <li>It's added to the map directly — live in a minute or two.</li>
            <li>A maintainer can tidy or enrich it later.</li>
          </ol>
        </div>
        <div class="card p-5">
          <h2 class="font-display text-lg font-semibold">🤖 Add it with ChatGPT</h2>
          <p class="mt-2 text-sm text-ink-soft">
            The fastest way from a phone. ChatGPT interviews you, then gives you a one-tap
            link that adds it to the map — using your own account.
          </p>
          <a href={chatGptUrl} target="_blank" rel="noopener" class="btn btn-primary mt-3 w-full justify-center">
            Open ChatGPT to add a place
          </a>
          <p class="mt-3 text-xs text-ink-soft">
            Maintainers can also run the built-in AI research assistant — see
            <a href={withBase("/admin")} class="link-underline text-sun">Admin & AI tools</a>.
          </p>
        </div>
        <div class="card p-5 text-sm text-ink-soft">
          Prefer to do it yourself? The full
          <a href={`${SITE.repo}/issues/new?labels=submission`} class="link-underline text-sun">GitHub issue form</a>
          works too.
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { withBase } from "../lib/url";

  const form = document.getElementById("submit-form") as HTMLFormElement | null;
  const status = document.getElementById("submit-status");

  // Hand off to /add, which confirms coordinates and publishes (the single, robust pipeline
  // shared with the ChatGPT flow). We pass the free-text location as `loc` so /add can try to
  // pull lat/lng out of a Google Maps link there.
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if ((fd.get("hp") as string)?.length) return; // honeypot

    const get = (k: string) => ((fd.get(k) as string) || "").trim();
    const title = get("title");
    if (!title || !get("description")) return;

    const p = new URLSearchParams();
    p.set("title", title);
    p.set("description", get("description"));
    p.set("summary", get("description").slice(0, 200));
    if (get("category")) p.set("category", get("category"));
    if (get("prefecture")) p.set("prefecture", get("prefecture"));
    if (get("city")) p.set("city", get("city"));
    if (get("location")) p.set("loc", get("location"));
    const seasons = fd.getAll("seasons").join(",");
    if (seasons) p.set("seasons", seasons);
    if (get("website")) p.set("website", get("website"));
    if (get("submittedBy")) p.set("by", get("submittedBy"));

    if (status) status.textContent = "Taking you to the final step…";
    location.href = `${withBase("/add")}?${p.toString()}`;
  });
</script>
