---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getIndexRecords } from "../../lib/content";
import { prefecturesByRegion, REGIONS } from "../../data/prefectures";
import { withBase } from "../../lib/url";

const records = await getIndexRecords();
const counts = new Map<string, number>();
for (const r of records) counts.set(r.prefecture, (counts.get(r.prefecture) ?? 0) + 1);
const byRegion = prefecturesByRegion();
---

<BaseLayout title="Prefectures" description="Browse Cinnamon Land by region — Japan’s 47 prefectures and Thailand’s provinces.">
  <div class="py-8">
    <header class="mb-6">
      <h1 class="font-display text-3xl font-bold sm:text-4xl">Browse by region</h1>
      <p class="mt-2 text-ink-soft">Japan's 47 prefectures and Thailand's provinces, grouped by region. Numbers show how many discoveries we've mapped so far.</p>
    </header>

    <div class="space-y-8">
      {
        REGIONS.map((region) => (
          <section>
            <h2 class="font-display text-xl font-bold">{region}</h2>
            <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
              {byRegion[region].map((p) => {
                const n = counts.get(p.slug) ?? 0;
                return (
                  <a
                    href={withBase(`/prefectures/${p.slug}`)}
                    class="card flex items-center justify-between px-3 py-2.5 transition hover:border-sun"
                  >
                    <span>
                      <span class="font-medium">{p.name}</span>
                      <span class="ml-1 text-xs text-ink-soft">{p.nameJa}</span>
                    </span>
                    <span class:list={["rounded-full px-2 py-0.5 text-xs", n > 0 ? "bg-sun text-white" : "bg-surface-2 text-ink-soft"]}>
                      {n}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
